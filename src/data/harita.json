  {
   "id": "havalimani",
   "name": "Valara Havalimanı",
   "district": "Havalimanı",
   "x": 300,
   "y": 1300,
   "chapter": 1,
   "text": "Alçak, geniş bir terminal binası. Şehre uçakla gelenler Valara'yı ilk kez burada, inişe geçerken körfezin üstünden görür."
  },
  {
   "id": "karanlik-liman",
   "name": "Karanlık Liman",
   "district": "Karanlık Liman",
   "x": 488,
   "y": 960,
   "chapter": 1,
   "text": "Batı yakasının yük limanı. Rıhtım boyunca dönen vinçler, eski depolar ve kamyon tekerleklerinden çukurlaşmış yollar."
  },
  {
   "id": "palmiye-oteli",
   "name": "Palmiye Oteli",
   "district": "Palmiye",
   "x": 1170,
   "y": 478,
   "chapter": 1,
   "text": "Sahil yoluna yakın, dört katlı, krem sıvası güneşten solmuş bir otel. Girişin üstünde pembe neon bir palmiye yanıp söner."
  },
  {
   "id": "sik-erkek-giyim",
