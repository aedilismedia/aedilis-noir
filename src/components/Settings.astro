<dialog id="reading-settings" aria-labelledby="settings-title"><div class="dialog-heading"><div><span class="eyebrow">SİZE AİT BİR SAYFA</span><h2 id="settings-title">Okuma ayarları</h2></div><button id="settings-close" aria-label="Okuma ayarlarını kapat">×</button></div><fieldset><legend>Sayfa rengi</legend><div class="choices themes"><button data-theme-choice="light"><i class="swatch light"></i>Aydınlık</button><button data-theme-choice="sepia"><i class="swatch sepia"></i>Sepya</button><button data-theme-choice="dark"><i class="swatch dark"></i>Koyu</button></div><button class="system-theme" id="system-theme">Sistem temasını izle</button></fieldset><fieldset><legend>Yazı boyutu</legend><div class="choices sizes">{[1,2,3,4,5].map((n,i)=><button data-size={i} aria-label={`Yazı boyutu ${n} / 5`}><span style={`font-size:${16+i*3}px`}>A</span></button>)}</div></fieldset><fieldset><legend>Satır aralığı</legend><div class="choices"><button data-leading="normal">Rahat</button><button data-leading="relaxed">Ferah</button></div></fieldset><fieldset><legend>Okuma genişliği</legend><div class="choices"><button data-width="normal">Kitap sayfası</button><button data-width="wide">Geniş sayfa</button></div></fieldset><p class="settings-note">Tercihleriniz bu cihazda hatırlanır.</p></dialog>
