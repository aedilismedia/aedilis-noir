---
import Layout from '../../layouts/Layout.astro';
import Settings from '../../components/Settings.astro';
import {book,chapters,href} from '../../lib/content';
import {characters} from '../../lib/characters';
import atlas from '../../data/harita.json';
import '../../styles/unlocks.css';
import '../../styles/gloss.css';
export function getStaticPaths(){const all=chapters();return all.map((chapter,i)=>({params:{slug:chapter.slug},props:{chapter,previous:all[i-1],next:all[i+1]}}));}
const {chapter:c,previous,next}=Astro.props;
// Bu bölümle ilk kez açılan karakterler ve mekanlar (okuma ilerlemesiyle aynı kural: ilk geçtiği bölüm).
const newPeople=characters().filter(person=>person.chapter===c.number);
const newPlaces=atlas.places.filter(place=>place.chapter===c.number);
// Sıralı okuma: bu bölümden önce gelen tüm bölümler (kilit kontrolü tarayıcıda yapılır).
const earlier=chapters().filter(x=>x.number<c.number).map(x=>({slug:x.slug,number:x.number,title:x.title,url:href(`bolum/${x.slug}/`)}));
const bookName=(book.books||[]).find(b=>Number(b.number)===c.book)?.title||`${c.book}. Kitap`;
---
<Layout title={c.documentTitle} description={c.description} reader><div class="reading-progress" role="progressbar" aria-label="Bölüm ilerlemesi" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div id="progress-fill"></div></div><main id="main" data-reader data-slug={c.slug} data-minutes={c.minutes} data-before={JSON.stringify(earlier)}><header class="chapter-heading"><a class="eyebrow" href={href('icindekiler/')}>{book.title.toUpperCase()} · {bookName.toLocaleUpperCase("tr-TR")}</a><div class="large-number" aria-hidden="true">{String(c.number).padStart(2,'0')}</div><span class="sr-only">Bölüm {c.number}</span><h1>{c.title}</h1>{c.subtitle&&<p class="chapter-subtitle">{c.subtitle}</p>}<div class="chapter-ornament" aria-hidden="true"><span></span>◇<span></span></div>{c.epigraph&&<blockquote>{c.epigraph}</blockquote>}<p class="reading-meta">{c.minutes} dakikalık okuma</p></header><section class="chapter-lock" id="chapter-lock" aria-labelledby="lock-title"><span class="ornament" aria-hidden="true">◇</span><h2 id="lock-title">Bu bölüm henüz kilitli</h2><p>Bölümler sırayla açılır. <strong id="lock-name">Önceki bölümü</strong> sonuna kadar okuduğunda bu bölüm kendiliğinden açılır.</p><div class="chapter-lock-actions"><a class="primary" id="lock-go" href={href('icindekiler/')}>Okumaya git</a><a href={href('icindekiler/')}>İçindekiler</a></div></section><script is:inline>(function(){try{var m=document.querySelector('[data-reader]');var b=JSON.parse(m.dataset.before||'[]');if(!b.length)return;if(localStorage.getItem('noir-gate-off')==='true')return;var p=JSON.parse(localStorage.getItem('noir-progress')||'{}')||{};var f=null;for(var i=0;i<b.length;i++){if(!(p[b[i].slug]&&p[b[i].slug].done)){f=b[i];break;}}if(!f)return;document.documentElement.setAttribute('data-locked','');var a=document.getElementById('lock-go');a.href=f.url;a.textContent=f.number+'. bölüme git';document.getElementById('lock-name').textContent=f.number+'. bölümü';}catch(e){}})();</script><article class="prose novel" id="chapter-text" aria-label={c.title} set:html={c.html}></article><div class="chapter-finish"><span class="ornament" aria-hidden="true">◇</span><p>Bölüm sonu</p></div>{(newPeople.length>0||newPlaces.length>0)&&<section class="unlocks" aria-labelledby="unlocks-title"><header><span class="eyebrow">BÖLÜM {String(c.number).padStart(2,'0')} SONRASI</span><h2 id="unlocks-title">Kilidi açılanlar</h2><p>Bu bölümle birlikte harita ve karakter sayfasına eklenenler.</p></header>{newPlaces.length>0&&<div class="unlock-group"><h3>Haritada</h3><ul>{newPlaces.map(place=><li><a href={href(`harita/#yer-${place.id}`)}><span class="unlock-mark" aria-hidden="true">◇</span><span class="unlock-text"><strong>{place.name}</strong><small>{place.district}</small></span></a></li>)}</ul></div>}{newPeople.length>0&&<div class="unlock-group"><h3>Karakterlerde</h3><ul>{newPeople.map(person=><li><a href={href(`karakterler/#${person.slug}`)}><span class="unlock-mark" aria-hidden="true">◇</span><span class="unlock-text"><strong>{person.name}</strong><small>{person.role}</small></span></a></li>)}</ul></div>}</section>}<nav class="chapter-navigation" aria-label="Bölümler arası gezinme">{previous?<a id="previous-chapter" href={href(`bolum/${previous.slug}/`)}><span class="eyebrow">ÖNCEKİ BÖLÜM</span><strong>{previous.title}</strong></a>:<a href={href('icindekiler/')}><span class="eyebrow">KİTABA DÖN</span><strong>İçindekiler</strong></a>}{next?<a id="next-chapter" href={href(`bolum/${next.slug}/`)}><span class="eyebrow">SONRAKİ BÖLÜM</span><strong>{next.title}</strong><span class="lock-note" hidden>Bölümü bitirince açılır</span></a>:<a href={href('icindekiler/')}><span class="eyebrow">ŞİMDİLİK SON SAYFA</span><strong>İçindekilere dön</strong></a>}</nav></main><div class="reading-status"><span>Bölüm {String(c.number).padStart(2,'0')}</span><span id="remaining-time" aria-live="off">{c.minutes} dk kaldı</span><button id="back-to-top" aria-label="Bölümün başına dön">Başa dön</button></div><Settings/><script>import '../../scripts/reader';import '../../scripts/gloss';</script></Layout>
