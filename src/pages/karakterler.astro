---
import Layout from '../layouts/Layout.astro';
import Seal from '../components/Seal.astro';
import {book,chapters,href} from '../lib/content';
import {characters} from '../lib/characters';
import '../styles/characters.css';
const people=characters();
const firstChapter=chapters()[0];
---
<Layout title="Karakterler" description={`${book.title} karakterleri: portreler ve hikayeyi açık etmeden kısa tanıtımlar.`} atlas>
<main id="main" class="character-atlas">
 <header class="atlas-heading">
  <div class="atlas-kicker"><span class="eyebrow">{book.title.toLocaleUpperCase('tr-TR')} · KARAKTER ATLASI</span><span class="atlas-edition" id="char-count">Portreler / {String(people.length).padStart(2,'0')}</span></div>
  <div class="atlas-title-row"><h1>Hikayenin</br><em>Yüzleri</em></h1><div class="atlas-intro"><Seal/><p>Bir ismin ardında bir insan.<br/>Bir insanın ardında bir hikaye.</p><span class="atlas-spoiler-note">Olay örgüsünü açığa çıkarmadan.<br/>Bir portrenin üzerine gel ya da dokun.</span></div></div>
  <div class="atlas-controls"><button id="char-mode" type="button">Tüm karakterleri göster</button><p id="char-scope" aria-live="polite"></p></div>
  </header>
 <div class="portrait-gallery" id="portrait-gallery">
 {people.map((person,index)=><article class="char-tile" id={person.slug} data-first={person.chapter} tabindex="0" aria-label={person.name}>
  <figure class="char-figure">
   <div class="portrait-mat">{person.image?<img src={href(person.image)} alt={person.imageAlt} width="768" height="1024" loading={index<4?'eager':'lazy'} fetchpriority={index===0?'high':'auto'} decoding="async" style={`object-position:${person.imagePosition}`}/>:<div class="portrait-pending"><Seal/><span>Portre hazırlanıyor</span></div>}</div>
   <div class="char-caption" aria-hidden="true"><span class="char-no">{String(index+1).padStart(2,'0')}</span><strong>{person.name}</strong><span class="char-caption-role">{person.role}</span></div>
  </figure>
  <div class="char-card"><span class="char-card-no" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><p class="eyebrow character-role">{person.role.toLocaleUpperCase('tr-TR')}</p><h2>{person.name}</h2><div class="profile-rule" aria-hidden="true"><span></span>◇</div>{person.age&&<p class="character-age">{person.age} yaşında</p>}<div class="character-bio prose" set:html={person.html}/>{person.portraitNote&&<p class="char-note">{person.portraitNote}</p>}</div>
 </article>)}
 </div>
 {people.length===0&&<p class="atlas-empty">Karakter portreleri yakında burada.</p>}
 <div class="char-empty" id="char-empty" hidden><div><h2>Karakterler okudukça açılır</h2><p>Henüz hiçbir karakterin izi açılmadı. Bölümleri okudukça yüzler buraya eklenir.</p><div class="char-empty-actions">{firstChapter&&<a href={href(`bolum/${firstChapter.slug}/`)}>Okumaya başla</a>}<button id="char-empty-all" type="button">Tüm karakterleri göster</button></div></div></div>
 <script is:inline>window.kutCharacters=function(){try{var g=function(k,d){try{var v=JSON.parse(localStorage.getItem(k));return v==null?d:v}catch(e){return d}};var n=function(x){var m=String(x).match(/(\d+)$/);return m?+m[1]:0};var pad=function(v){return String(v).padStart(2,'0')};var all=g('kut-atlas-all',false)===true,pr=g('kut-progress',{}),h=n(g('kut-last','')),k;for(k in pr)h=Math.max(h,n(k));var list=document.querySelectorAll('.char-tile'),open=0;list.forEach(function(e){var hide=!all&&Number(e.dataset.first)>h;e.hidden=hide;if(!hide){open++;e.querySelectorAll('.char-no,.char-card-no').forEach(function(x){x.textContent=pad(open)})}});var c=document.getElementById('char-count');if(c)c.textContent=all?'Portreler / '+pad(list.length):'Portreler / '+pad(open)+' / '+pad(list.length);var b=document.getElementById('char-mode');if(b)b.textContent=all?'Yalnızca okuduklarım':'Tüm karakterleri göster';var s=document.getElementById('char-scope');if(s)s.textContent=all?'Spoiler korumasını kapattın: tüm karakterler gösteriliyor.':(open?'Okuduğun bölümlere göre '+open+' karakter açık. Okudukça yenileri eklenir.':'');var e2=document.getElementById('char-empty');if(e2)e2.hidden=open>0;var gl=document.getElementById('portrait-gallery');if(gl)gl.hidden=open===0;return open}catch(e){return 0}};window.kutCharacters();</script>
 <dialog id="char-spoiler" aria-labelledby="char-spoiler-title"><div class="char-spoiler-inner"><p class="eyebrow">SPOILER UYARISI</p><h2 id="char-spoiler-title">Hikayenin ilerisini görebilirsin</h2><p>Tüm karakterler açılırsa, henüz okumadığın bölümlerde tanışacağın kişiler ve kısa tanıtımları görünür. Hikayeyi okuyarak keşfetmek istiyorsan şimdilik vazgeçebilirsin.</p><div class="char-spoiler-actions"><button id="char-spoiler-cancel" type="button">Vazgeç</button><button id="char-spoiler-accept" type="button">Yine de tümünü göster</button></div></div></dialog>
 <div class="atlas-return"><span class="eyebrow">HİKAYE DEVAM EDİYOR</span><a href={href('icindekiler/')}>İçindekiler</a><span class="atlas-return-line" aria-hidden="true"></span></div>
</main>
<script>import '../scripts/characters';</script>
</Layout>
