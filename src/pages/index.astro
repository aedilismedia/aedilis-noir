---
import Layout from '../layouts/Layout.astro';
import Seal from '../components/Seal.astro';
import {book,chapters,href} from '../lib/content';
import '../styles/home-menu.css';
import '../styles/home-energy.css';
import '@fontsource/monoton/latin-400.css';
import '@fontsource/yellowtail/latin-400.css';
import '@fontsource/yellowtail/latin-ext-400.css';
import '../styles/neon-cover.css';
const all=chapters();
const connections=['M345 335 L300 335 L255 200 L210 200','M655 335 L700 335 L745 200 L790 200','M345 465 L300 465 L255 600 L210 600',...(book.showUniverse?['M655 465 L700 465 L745 600 L790 600']:[])];
const portals=[
 {path:'icindekiler/',title:'İçindekiler',note:'Hikayenin sayfaları',position:'nw',number:'I'},
 {path:'karakterler/',title:'Karakterler',note:'Körfezin yüzleri',position:'ne',number:'II'},
 {path:'valara/',title:'Valara',note:'Akdeniz’in İncisi',position:'sw',number:'III'},
 ...(book.showUniverse?[{path:'evren/',title:'Evren',note:'Başka bir Türkiye, 1986',position:'se',number:'IV'}]:[])
];
---
<Layout cover><main id="main"><section class="cover-stage game-cover" aria-labelledby="book-title"><svg class="neon-scene" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true"><defs><linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0d1226"/><stop offset=".38" stop-color="#1f1a45"/><stop offset=".6" stop-color="#5a2466"/><stop offset=".72" stop-color="#c8366f"/><stop offset=".78" stop-color="#e6834f"/></linearGradient><linearGradient id="sun" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f7d58a"/><stop offset=".55" stop-color="#f08a4b"/><stop offset="1" stop-color="#d63779"/></linearGradient><linearGradient id="sea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a1c4a"/><stop offset="1" stop-color="#0b0f20"/></linearGradient><mask id="sunstripes"><rect width="1600" height="900" fill="#fff"/><g fill="#000"><rect x="0" y="560" width="1600" height="5"/><rect x="0" y="586" width="1600" height="7"/><rect x="0" y="612" width="1600" height="9"/><rect x="0" y="636" width="1600" height="11"/></g></mask></defs><rect width="1600" height="900" fill="url(#sky)"/><g class="stars" fill="#f2e6cf"><circle cx="210" cy="90" r="1.2"/><circle cx="480" cy="160" r="1"/><circle cx="760" cy="70" r="1.4"/><circle cx="1010" cy="130" r="1"/><circle cx="1290" cy="80" r="1.3"/><circle cx="1460" cy="190" r="1"/><circle cx="350" cy="250" r=".9"/><circle cx="1180" cy="240" r=".9"/></g><circle cx="800" cy="650" r="230" fill="url(#sun)" mask="url(#sunstripes)" class="sun"/><rect y="650" width="1600" height="250" fill="url(#sea)"/><g class="sea-lines" stroke="#25b9c1" stroke-linecap="round"><path d="M640 672h320" stroke-opacity=".55" stroke-width="2"/><path d="M590 700h420" stroke-opacity=".4" stroke-width="2"/><path d="M540 734h520" stroke-opacity=".28" stroke-width="2"/><path d="M480 776h640" stroke-opacity=".18" stroke-width="2"/></g><path d="M0 650h1600" stroke="#f06aa3" stroke-width="2" class="horizon"/><g class="skyline" fill="#0b0f20"><path d="M180 650v-60h30v-30h24v90zM250 650v-110h40v110zM300 650v-70h22v-24h20v94zM1240 650v-90h34v90zM1286 650v-140h18v-18h20v158zM1336 650v-64h40v64zM1390 650v-100h26v100z"/></g><g class="palms" fill="#080b18"><g transform="translate(70 0)"><path d="M0 800 C 6 700 14 600 40 470 C 44 452 50 440 56 432 L 62 436 C 54 450 50 470 46 490 C 26 600 18 700 16 800 Z"/><path d="M58 434 C 20 400 -30 400 -70 430 C -30 418 10 420 50 446 Z M58 434 C 30 380 -10 360 -60 362 C -20 374 20 396 52 440 Z M58 434 C 70 380 100 350 150 340 C 110 362 84 390 66 440 Z M58 434 C 110 410 160 420 196 452 C 150 436 110 434 64 444 Z M58 434 C 90 440 120 470 130 520 C 110 480 86 458 60 446 Z M58 434 C 40 450 20 480 14 520 C 30 484 44 462 60 446 Z M58 434 C 56 390 66 360 90 336 C 76 364 70 394 64 436 Z"/></g><g transform="translate(170 60) scale(.8)"><path d="M0 800 C 6 700 14 600 40 470 C 44 452 50 440 56 432 L 62 436 C 54 450 50 470 46 490 C 26 600 18 700 16 800 Z"/><path d="M58 434 C 20 400 -30 400 -70 430 C -30 418 10 420 50 446 Z M58 434 C 30 380 -10 360 -60 362 C -20 374 20 396 52 440 Z M58 434 C 70 380 100 350 150 340 C 110 362 84 390 66 440 Z M58 434 C 110 410 160 420 196 452 C 150 436 110 434 64 444 Z M58 434 C 90 440 120 470 130 520 C 110 480 86 458 60 446 Z M58 434 C 40 450 20 480 14 520 C 30 484 44 462 60 446 Z M58 434 C 56 390 66 360 90 336 C 76 364 70 394 64 436 Z"/></g><g transform="translate(1530 0) scale(-1 1)"><path d="M0 800 C 6 700 14 600 40 470 C 44 452 50 440 56 432 L 62 436 C 54 450 50 470 46 490 C 26 600 18 700 16 800 Z"/><path d="M58 434 C 20 400 -30 400 -70 430 C -30 418 10 420 50 446 Z M58 434 C 30 380 -10 360 -60 362 C -20 374 20 396 52 440 Z M58 434 C 70 380 100 350 150 340 C 110 362 84 390 66 440 Z M58 434 C 110 410 160 420 196 452 C 150 436 110 434 64 444 Z M58 434 C 90 440 120 470 130 520 C 110 480 86 458 60 446 Z M58 434 C 40 450 20 480 14 520 C 30 484 44 462 60 446 Z M58 434 C 56 390 66 360 90 336 C 76 364 70 394 64 436 Z"/></g><g transform="translate(1440 60) scale(-.8 .8)"><path d="M0 800 C 6 700 14 600 40 470 C 44 452 50 440 56 432 L 62 436 C 54 450 50 470 46 490 C 26 600 18 700 16 800 Z"/><path d="M58 434 C 20 400 -30 400 -70 430 C -30 418 10 420 50 446 Z M58 434 C 30 380 -10 360 -60 362 C -20 374 20 396 52 440 Z M58 434 C 70 380 100 350 150 340 C 110 362 84 390 66 440 Z M58 434 C 110 410 160 420 196 452 C 150 436 110 434 64 444 Z M58 434 C 90 440 120 470 130 520 C 110 480 86 458 60 446 Z M58 434 C 40 450 20 480 14 520 C 30 484 44 462 60 446 Z M58 434 C 56 390 66 360 90 336 C 76 364 70 394 64 436 Z"/></g></g></svg><div class="cover-frame"></div>{book.coverImage&&<img class="cover-image" src={href(book.coverImage)} alt=""/>}<svg class="menu-connections" viewBox="0 0 1000 800" preserveAspectRatio="none" aria-hidden="true"><g class="connection-base" fill="none" stroke="currentColor" stroke-width="1">{connections.map((d,i)=><path d={d} pathLength="1" style={`--branch:${i}`}/>)}</g><g class="energy-trails" fill="none" stroke-width="1.8">{connections.map((d,i)=><path d={d} pathLength="1" style={`--branch:${i}`}/>)}</g><g class="hover-energy" fill="none" stroke="#ecc68a" stroke-width="2" stroke-linecap="round">{connections.map((d,i)=><path d={d} pathLength="1" data-branch={i}/>)}</g><g fill="currentColor"><circle cx="345" cy="335" r="2"/><circle cx="655" cy="335" r="2"/><circle cx="345" cy="465" r="2"/>{book.showUniverse&&<circle cx="655" cy="465" r="2"/>}</g></svg><div class="cover-content"><p class="eyebrow">VALARA · 1986</p><Seal energized/><h1 id="book-title"><span class="living-title" lang="en">{book.title}</span></h1><p class="cover-script">{book.subtitle}</p><p class="author">{book.author}</p><div class="little-rule"></div><p class="cover-description">{book.description}</p><a class="primary-button" id="resume-link" data-chapters={JSON.stringify(all.map(c=>({slug:c.slug,url:href(`bolum/${c.slug}/`)})))} href={all.length?href(`bolum/${all[0].slug}/`):href('icindekiler/')}>{all.length?'Okumaya Başla':'İçindekiler'}</a><a class="studio-return" href="https://aedilismedia.com" rel="noopener"><span aria-hidden="true">←</span> <i lang="en" style="font-style:normal">Aedilis Media’ya dön</i></a></div><nav class="portal-menu" aria-label="Kitabı keşfet">{portals.map((portal,i)=><a class={`menu-portal portal-${portal.position}`} style={`--branch:${i}`} href={href(portal.path)}><span class="portal-index" aria-hidden="true">{portal.number}</span><span class="portal-title">{portal.title}</span><span class="portal-note">{portal.note}</span><span class="portal-joint" aria-hidden="true">◇</span></a>)}</nav><button id="cover-motion" class="cover-motion" type="button" aria-pressed="false" hidden>Hareketi durdur</button><div class="cover-bottom"><span>{book.genre || 'ROMAN'}</span><span>DİJİTAL KİTAP · {String(all.length).padStart(2,'0')}{book.plannedChapters?` / ${book.plannedChapters}`:''} BÖLÜM</span></div></section>{book.preface&&<section class="foreword page-shell" aria-labelledby="foreword-title"><span class="eyebrow">KİTABI AÇARKEN</span><h2 id="foreword-title">{book.prefaceTitle}</h2>{book.preface.split(/\n+/).filter(Boolean).map(paragraph=><p>{paragraph}</p>)}<p class="dedication">{book.dedication}</p><div class="ornament" aria-hidden="true">◇</div><blockquote>{book.epigraph}</blockquote></section>}</main></Layout>

<script>import '../scripts/home-energy';</script>
